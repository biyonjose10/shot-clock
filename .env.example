# ---------------------------------------------------------------------------
# Shot Clock configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Grafana Cloud: telemetry ingest (OTLP) --------------------------------
# From: your stack -> Connections -> Add new connection -> OpenTelemetry (OTLP)
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
GRAFANA_OTLP_INSTANCE_ID=000000
GRAFANA_OTLP_TOKEN=

# --- Grafana Cloud: query + write (MCP server) -----------------------------
# From: your stack -> Administration -> Users and access -> Service accounts
# The service account role must be Admin (incident/dashboard/annotation writes).
GRAFANA_URL=https://<your-stack>.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# --- Google AI ------------------------------------------------------------
# Local iteration: AI Studio key, GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Deployed build: flip to TRUE and the two GOOGLE_CLOUD_* vars take over.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# --- Simulator ------------------------------------------------------------
SHOT_CLOCK_DELIVERY_DATE=2026-09-30
