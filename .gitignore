# Python
.venv/
__pycache__/
*.py[cod]

# Secrets — never commit
.env

# Vendored mcp-grafana binary (downloaded by scripts/fetch_mcp_grafana.ps1)
bin/

# Ad-hoc run journals; the curated demo journal IS committed
journals/live-*.jsonl

# Generated frames and audio. The voiceover lives in demo/audio/, which
# `demo/*.wav` did not match -- so 8MB of generated speech sat one stray
# `git add -A` away from the history.
web/static/frames/*.png
demo/*.wav
demo/audio/
.tools/

# Run state, not source: quota ledgers, live-call counters and stage
# checkpoints. journals/live-*.jsonl was already covered; these were not, so a
# stale .live_check.json was being baked into the container image.
journals/.*.json
journals/*.checkpoint.json
